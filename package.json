{
  "name": "vue-frontend-learning-starter",
  "version": "1.0.0",
  "private": true,
  "description": "A Vue 3 practice project that helps beginners quickly learn frontend software development.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
